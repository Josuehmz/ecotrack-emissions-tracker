{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "jsx-a11y"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [
    "bitacora/**",
    "dist/**"
  ],
  "overrides": [
    {
      "files": [
        "src/components/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@supabase/supabase-js",
                "message": "Arquitectura: solo src/lib/ y src/services/ usan Supabase."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/lib/*",
                  "**/lib/**"
                ],
                "message": "Arquitectura: la UI no usa el cliente de Supabase; habla con un hook de src/hooks/."
              },
              {
                "group": [
                  "**/services",
                  "**/services/*",
                  "**/services/**"
                ],
                "message": "Arquitectura: la UI no llama servicios; usa useEmissions()."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/hooks/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@supabase/supabase-js",
                "message": "Arquitectura: solo src/lib/ y src/services/ usan Supabase."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/lib/*",
                  "**/lib/**"
                ],
                "message": "Arquitectura: los hooks usan services/, no el cliente de lib/."
              }
            ]
          }
        ]
      }
    }
  ]
}
